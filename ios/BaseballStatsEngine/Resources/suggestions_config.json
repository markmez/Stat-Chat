  "templates": {
    "current": {
      "streak": [
        "Did {player} have any hot streaks {seasonLabel}?",
        "When was {player}'s coldest stretch {seasonLabel}?",
        "Did {player} go on any hot runs {seasonLabel}?"
      ],
      "comparison": [
        "{player1} vs {player2} {seasonLabel}",
        "Compare {player1} and {player2} {seasonLabel}"
      ],
      "splits": [
        "How did {player} hit against lefties {seasonLabel}?",
        "{player} platoon splits {seasonLabel}",
        "{player}'s splits vs lefties {seasonLabel}"
      ],
      "homeAway": [
        "{player} home vs away {seasonLabel}",
        "How did {player} hit at home {seasonLabel}?"
      ],
      "playerLookup": [
        "How did {player} do {seasonLabel}?",
        "What was {player}'s slash line {seasonLabel}?",
        "{player} {seasonLabel}"
      ]
    },
    "historical": {
      "streak": [
        "Did {player} have any hot streaks in {year}?",
        "When was {player}'s coldest stretch in {year}?"
      ],
      "comparison": [
        "{player1} vs {player2} career stats",
        "Compare {player1} and {player2}"
      ],
      "splits": [
        "How did {player} hit against lefties in his career?",
        "{player} career platoon splits"
      ],
      "homeAway": [
        "{player} career home vs away splits",
        "How did {player} hit at home in his career?"
      ],
      "playerLookup": [
        "How did {player} do in {year}?",
        "{player} career stats",
        "How did {player} hit in September {year}?"
      ]
    }
  },
  "dynamicQueries": {
    "batting": [
      {
        "label": "HR leaders",
        "sql": "SELECT p.name FROM season_batting_stats s JOIN players p ON s.player_id = p.player_id WHERE s.season = {season} AND s.at_bats >= 50 ORDER BY s.home_runs DESC LIMIT 5",
        "templates": [
          "How many home runs did {player} hit {seasonLabel}?",
          "{player}'s home run numbers {seasonLabel}"
        ]
      },
      {
        "label": "OPS leaders",
        "sql": "SELECT p.name FROM season_batting_stats s JOIN players p ON s.player_id = p.player_id WHERE s.season = {season} AND s.at_bats >= 100 ORDER BY s.ops DESC LIMIT 5",
        "templates": [
          "What was {player}'s OPS {seasonLabel}?",
          "How did {player} do {seasonLabel}?"
        ]
      },
      {
        "label": "AVG leaders",
        "sql": "SELECT p.name FROM season_batting_stats s JOIN players p ON s.player_id = p.player_id WHERE s.season = {season} AND s.at_bats >= 100 ORDER BY s.batting_avg DESC LIMIT 5",
        "templates": [
          "{player}'s slash line {seasonLabel}",
          "{player}'s batting average {seasonLabel}"
        ]
      },
      {
        "label": "SB leaders",
        "sql": "SELECT p.name FROM season_batting_stats s JOIN players p ON s.player_id = p.player_id WHERE s.season = {season} AND s.at_bats >= 50 ORDER BY s.stolen_bases DESC LIMIT 5",
        "templates": [
          "{player}'s stolen base numbers {seasonLabel}",
          "How many bases did {player} steal {seasonLabel}?"
        ]
      }
    ],
    "pitching": [
      {
        "label": "W leaders",
        "sql": "SELECT p.name FROM season_pitching_stats sp JOIN players p ON sp.player_id = p.player_id WHERE sp.season = {season} AND sp.games_started >= 5 ORDER BY sp.wins DESC LIMIT 5",
        "templates": [
          "How did {player} pitch {seasonLabel}?",
          "{player}'s pitching stats {seasonLabel}"
        ]
      },
      {
        "label": "SO leaders",
        "sql": "SELECT p.name FROM season_pitching_stats sp JOIN players p ON sp.player_id = p.player_id WHERE sp.season = {season} AND sp.games_started >= 5 ORDER BY sp.strikeouts DESC LIMIT 5",
        "templates": [
          "{player}'s strikeout numbers {seasonLabel}",
          "How many strikeouts did {player} have {seasonLabel}?"
        ]
      },
      {
        "label": "ERA leaders",
        "sql": "SELECT p.name FROM season_pitching_stats sp JOIN players p ON sp.player_id = p.player_id WHERE sp.season = {season} AND sp.games_started >= 10 ORDER BY sp.era ASC LIMIT 5",
        "templates": [
          "What was {player}'s ERA {seasonLabel}?",
          "{player}'s ERA {seasonLabel}"
        ]
      }
    ]
  }
}