# StatChat data refresh — game-end oriented schedule
# Nightly cascade: 11:35 PM, 12:35 AM, 1:35 AM, 2:35 AM EDT (covers ET→PT game ends)
# Early morning catch-all: 5:35 AM EDT
# Afternoon games: 5:00 PM EDT daily
# Weekend 4 PM starts: 7:30 PM EDT (Sat/Sun only)

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

35 3,4,5,6,9 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 21 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
30 23 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
