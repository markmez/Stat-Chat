# StatChat data refresh
#
# WEEKNIGHTS (Mon-Fri mornings, Sun-Thu games):
#   1:00 AM, 2:35 AM, 4:05 AM, 5:35 AM, 8:00 AM, 10:00 AM ET
# WEEKENDS (Sat-Sun mornings, Fri-Sat games — shifted later):
#   2:35 AM, 5:35 AM, 7:00 AM, 8:30 AM, 10:00 AM, 11:30 AM ET
# Afternoon: 5:00 PM ET daily
# Weekend early starts: 7:30 PM ET (Sat/Sun only)
#
# WEEKLY MAINTENANCE — Tuesday (Monday is common off day)
#   3:00 AM ET: Records rebuild (runs 2+ hours)
#   4:00 AM ET: VACUUM (Tue + Fri)
#   4:30 AM ET: Full reconciliation

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Weeknight cascade: 1:00 AM, 2:35 AM, 4:05 AM, 5:35 AM, 8:00 AM ET (Mon-Fri)
0 5 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
35 6 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
5 8 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
35 9 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 12 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 14 * * 1,2,3,4,5 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Weekend cascade: 2:35 AM, 5:35 AM, 7:00 AM, 8:30 AM, 10:00 AM, 11:30 AM ET (Sat-Sun)
35 6 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
35 9 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 11 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
30 12 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 14 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
30 15 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Afternoon games: 5:00 PM ET (21:00 UTC) daily
0 21 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Weekend early starts: 7:30 PM ET (23:30 UTC, Sat/Sun only)
30 23 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# WEEKLY MAINTENANCE — Tuesday morning (Monday common off day)
# VACUUM: Tuesday + Friday 4:00 AM ET (08:00 UTC)
0 8 * * 2,5 statchat /opt/statchat/repo/deploy/vacuum.sh >> /data/refresh.log 2>&1

# Weekly full reconciliation: Tuesday 4:30 AM ET (08:30 UTC)
30 8 * * 2 statchat /opt/statchat/repo/deploy/refresh.sh --full-refresh >> /data/refresh.log 2>&1

# Weekly records rebuild: Tuesday 3:00 AM ET (07:00 UTC) — ~2-3 min with
# indexed teams-lookup + franchise grouping (was 2+ hours before the refactor).
0 7 * * 2 statchat /opt/statchat/venv/bin/python /opt/statchat/repo/backend/data_pipeline/build_records.py --db /data/baseball_stats_full.db >> /data/refresh.log 2>&1

# Weekly career ranks rebuild: Tuesday 3:30 AM ET (07:30 UTC).
# Career ranks for active players move at most 1-2 ranks per week, so weekly is fine.
30 7 * * 2 statchat /opt/statchat/venv/bin/python /opt/statchat/repo/backend/data_pipeline/build_career_ranks.py --db /data/baseball_stats_full.db >> /data/refresh.log 2>&1

# Weekly historical_streaks rebuild: Tuesday 3:45 AM ET (07:45 UTC).
# Refreshes the all-time leaderboard of hitting + on-base streaks
# (length >= 20/25). Used by the feed's "longest since X" lookup, so
# without weekly refresh, recently-completed cross-season streaks
# (e.g. Ohtani's 53-game Aug 2025 → Apr 2026) never show up as
# comparison points for new active streaks.
45 7 * * 2 statchat /opt/statchat/venv/bin/python /opt/statchat/repo/backend/data_pipeline/build_historical_streaks.py --db /data/baseball_stats_full.db >> /data/refresh.log 2>&1

# Daily subscription revalidation: 4:45 AM ET (08:45 UTC) — refund leak backstop.
# Polls Apple's App Store Server API for every paid device and downgrades any
# whose subscription is no longer Active/grace. Catches refunds/revokes that
# the SN V2 webhook missed. Lightweight curl, ~1s per paid device.
45 8 * * * statchat curl -sS -X POST "http://127.0.0.1:8000/admin/revalidate-subscriptions" -H "Authorization: Bearer $(grep ^ADMIN_KEY= /opt/statchat/.env | cut -d= -f2-)" >> /data/refresh.log 2>&1

# Nightly answer-correctness judge: 5:15 AM ET (09:15 UTC). Haiku reads
# yesterday's (question, answer) pairs from query_log.response_preview and
# flags answers that address a different question than asked (wrong player/
# scope/stat/season). Flags land in answer_judgments + dashboard alerts.
15 9 * * * statchat /opt/statchat/venv/bin/python /opt/statchat/repo/backend/scripts/judge_answers.py --env-file /opt/statchat/.env >> /data/judge.log 2>&1

# Health monitor: every 5 min, pings Healthchecks.io if API + DB are up
*/5 * * * * statchat /opt/statchat/repo/deploy/healthcheck.sh
# deploy trigger 2026-08-06 (WAL + recovery)
