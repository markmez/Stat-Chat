# StatChat data refresh — game-end oriented schedule
#
# Nightly cascade (90 min apart): 11:35 PM, 1:05 AM, 2:35 AM ET
# Morning catch-alls: 5:35 AM, 8:00 AM ET
# Afternoon games: 5:00 PM ET daily
# Weekend early starts: 7:30 PM ET (Sat/Sun only)
# Backup: 10:00 AM ET — catches data MSF publishes late
#
# WEEKLY MAINTENANCE — Tuesday (Monday is common off day, less data urgency)
#   4:00 AM ET: VACUUM
#   4:30 AM ET: Full reconciliation
#   3:00 AM ET: Records rebuild (runs 2+ hours, finishes before 5:35 AM cascade)

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Nightly cascade (90 min apart) + morning catch-alls
35 3 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
5 5 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
35 6 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
35 9 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1
0 12 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Afternoon games: 5:00 PM ET (21:00 UTC)
0 21 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Weekend early starts: 7:30 PM ET (23:30 UTC, Sat/Sun only)
30 23 * * 0,6 statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# Backup pipeline: 10:00 AM ET (14:00 UTC) — catches data MSF publishes late
0 14 * * * statchat /opt/statchat/repo/deploy/refresh.sh >> /data/refresh.log 2>&1

# WEEKLY MAINTENANCE — Tuesday morning (Monday common off day)
# VACUUM: Tuesday + Friday 4:00 AM ET (08:00 UTC)
0 8 * * 2,5 statchat /opt/statchat/repo/deploy/vacuum.sh >> /data/refresh.log 2>&1

# Weekly full reconciliation: Tuesday 4:30 AM ET (08:30 UTC)
30 8 * * 2 statchat /opt/statchat/repo/deploy/refresh.sh --full-refresh >> /data/refresh.log 2>&1

# Weekly records rebuild: Tuesday 3:00 AM ET (07:00 UTC) — runs 2+ hours, finishes before 5:35 AM cascade
0 7 * * 2 statchat /opt/statchat/venv/bin/python /opt/statchat/repo/backend/data_pipeline/build_records.py --db /data/baseball_stats_full.db >> /data/refresh.log 2>&1

# Health monitor: every 5 min, pings Healthchecks.io if API + DB are up
*/5 * * * * statchat /opt/statchat/repo/deploy/healthcheck.sh
